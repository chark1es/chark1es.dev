---
import Layout from "@/layouts/Layout.astro";
import Mascot from "@/components/react/Mascot.tsx";
---

<Layout title="404 · Charles Nguyen" description="Page not found">
    <div class="container-x page">
        <div class="lost">
            <div class="lost__face">
                <Mascot
                    client:load
                    seed="lost"
                    shape="triangle"
                    tone="pink"
                    rest="sad"
                    hover="unsure"
                    pokes={["scared", "surprised", "sad"]}
                    label="Poke the lost blobatar"
                />
            </div>
            <h1
                class="text-[clamp(3rem,9vw,6rem)] font-extrabold leading-none tracking-tight"
            >
                Nothing here.
            </h1>
            <p class="max-w-md text-[1.15rem] text-text-muted">
                I looked everywhere. Either this page moved or it never existed,
                and the blob is taking it personally.
            </p>
            <a href="/" class="btn mt-2"> Back home </a>
        </div>
    </div>
</Layout>
