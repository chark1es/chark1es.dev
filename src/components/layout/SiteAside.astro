---
const sections = [
    { id: "about", label: "About" },
    { id: "experience", label: "Experience" },
    { id: "projects", label: "Projects" },
    { id: "education", label: "Education" },
];
---

<aside class="site-aside" aria-label="On this page">
    <div class="site-aside-inner flex flex-col gap-6">
        <div class="space-y-1.5">
            <p class="font-medium text-text">Charles Nguyen</p>
            <p>UCSD Undergraduate</p>
        </div>

        <nav aria-label="Sections">
            <ul class="space-y-2.5 border-l border-border pl-3.5">
                {
                    sections.map((s) => (
                        <li>
                            <a
                                href={`#${s.id}`}
                                class="text-text-muted no-underline hover:text-text"
                            >
                                {s.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="space-y-2.5 border-t border-border pt-5">
            <a
                href="mailto:contact@chark1es.dev"
                class="block text-text-muted no-underline hover:text-text"
            >
                Email
            </a>
            <a
                href="https://github.com/chark1es"
                target="_blank"
                rel="noopener noreferrer"
                class="block text-text-muted no-underline hover:text-text"
            >
                GitHub
            </a>
        </div>
    </div>
</aside>
