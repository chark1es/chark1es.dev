---
const year = new Date().getFullYear();
const socials = [
    { label: "GitHub", href: "https://github.com/chark1es" },
    { label: "Email", href: "mailto:contact@chark1es.dev" },
    { label: "RSS", href: "/rss.xml" },
];
---

<footer class="site-footer">
    <div class="container-x footer-inner">
        <span>
            © {year} Charles Nguyen. Faces by
            <a
                href="https://blobatar.dev"
                target="_blank"
                rel="noopener noreferrer">blobatar</a
            >.
        </span>
        <nav aria-label="Social">
            {
                socials.map((social) => (
                    <a
                        href={social.href}
                        target={
                            social.href.startsWith("http")
                                ? "_blank"
                                : undefined
                        }
                        rel={
                            social.href.startsWith("http")
                                ? "noopener noreferrer"
                                : undefined
                        }
                    >
                        {social.label}
                    </a>
                ))
            }
        </nav>
    </div>
</footer>
