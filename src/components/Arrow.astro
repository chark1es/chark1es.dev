---
interface Props {
    class?: string;
    /** `right` for in-page moves, `up-right` for links that leave the site. */
    dir?: "right" | "up-right";
}

const { class: className, dir = "right" } = Astro.props;
---

{
    dir === "up-right" ? (
        <svg
            class:list={["arrow", "arrow--up-right", className]}
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M3.5 10.5L10.5 3.5" />
            <path d="M4.5 3.5h6v6" />
        </svg>
    ) : (
        <svg
            class:list={["arrow", "arrow--right", className]}
            width="18"
            height="12"
            viewBox="0 0 18 12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M1.5 6h14" />
            <path d="M11 1.5L15.5 6 11 10.5" />
        </svg>
    )
}
