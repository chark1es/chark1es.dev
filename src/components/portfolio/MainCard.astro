---
import TechPill from "./TechPill.astro";
---

<div class="relative">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-10">
        <img
            src="/images/derp.png"
            alt="Charles Nguyen"
            width="112"
            height="112"
            class="h-28 w-28 shrink-0 rounded-2xl object-cover ring-1 ring-border shadow-sm"
        />
        <div class="min-w-0 flex-1">
            <h1
                class="text-3xl font-semibold tracking-tight text-text sm:text-4xl"
            >
                Charles Nguyen
            </h1>
            <p class="mt-2 text-sm font-medium text-accent">
                CS @ UC San Diego · IEEE UCSD · Full-stack developer
            </p>

            <dl class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
                <div>
                    <dt class="text-text-muted">Email</dt>
                    <dd class="mt-0.5">
                        <a
                            href="mailto:contact@chark1es.dev"
                            class="text-text no-underline hover:text-accent"
                        >
                            contact@chark1es.dev
                        </a>
                    </dd>
                </div>
                <div>
                    <dt class="text-text-muted">Based in</dt>
                    <dd class="mt-0.5 text-text">San Diego, California</dd>
                </div>
            </dl>

            <div class="mt-6 flex flex-wrap gap-2">
                <TechPill
                    label="Resume"
                    icon="mdi:resume"
                    href="/pdfs/my_resume"
                />
                <TechPill
                    label="GitHub"
                    icon="mdi:github"
                    href="https://github.com/chark1es"
                />
            </div>
        </div>
    </div>

    <p
        class="mt-8 max-w-2xl text-base leading-relaxed text-text-muted sm:mt-10 sm:text-[1.05rem] sm:leading-relaxed"
    >
        I'm a fourth-year Computer Science student at UC San Diego building
        secure, user-centered full-stack systems across IEEE UCSD, HDSI Lab 3.0,
        and AI-powered tools that make real workflows easier.
    </p>
</div>
