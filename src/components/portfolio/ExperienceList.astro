---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import TechPill from "./TechPill.astro";

type ExperienceItem = {
    entry: Awaited<ReturnType<typeof getCollection<"experiences">>>[number];
    Content: Awaited<ReturnType<typeof render>>["Content"];
    excerpt: string;
    isTruncated: boolean;
};

const EXCERPT_LENGTH = 165;

function getPlainText(markdown: string) {
    return markdown
        .replace(/```[\s\S]*?```/g, " ")
        .replace(/`([^`]+)`/g, "$1")
        .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
        .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
        .replace(/^#{1,6}\s+/gm, "")
        .replace(/^[-*+]\s+/gm, "")
        .replace(/[*_~>]/g, "")
        .replace(/\s+/g, " ")
        .trim();
}

function getExcerpt(markdown: string, maxLength = EXCERPT_LENGTH) {
    const text = getPlainText(markdown);

    if (text.length <= maxLength) {
        return { excerpt: text, isTruncated: false };
    }

    const truncated = text.slice(0, maxLength);
    const lastSpace = truncated.lastIndexOf(" ");
    return {
        excerpt: `${truncated.slice(0, lastSpace > 0 ? lastSpace : maxLength)}...`,
        isTruncated: true,
    };
}

const entries = (await getCollection("experiences")).sort((a, b) =>
    a.id.localeCompare(b.id),
);

const items: ExperienceItem[] = await Promise.all(
    entries.map(async (entry) => {
        const { Content } = await render(entry);
        const { excerpt, isTruncated } = getExcerpt(entry.body ?? "");
        return { entry, Content, excerpt, isTruncated };
    }),
);

const groupMap = new Map<string, ExperienceItem[]>();
for (const item of items) {
    const key = item.entry.data.location;
    const group = groupMap.get(key) ?? [];
    group.push(item);
    groupMap.set(key, group);
}

for (const group of groupMap.values()) {
    group.sort((a, b) => a.entry.id.localeCompare(b.entry.id));
}

const groups = [...groupMap.entries()]
    .map(([location, roles]) => ({
        location,
        roles,
        sortKey: roles[0]!.entry.id,
        logo: roles[0]!.entry.data.logo,
    }))
    .sort((a, b) => a.sortKey.localeCompare(b.sortKey));
---

<ul class="divide-y divide-border">
    {
        groups.map(({ location, roles, logo }) => (
            <li class="py-5 first:pt-0 last:pb-0">
                <div class="flex gap-3">
                    <Image
                        src={logo}
                        alt=""
                        width={32}
                        height={32}
                        class="mt-0.5 h-8 w-8 shrink-0 rounded-md bg-pill object-contain"
                    />
                    <div class="min-w-0 flex-1">
                        <p class="font-medium text-text">{location}</p>
                        <ul
                            class:list={[
                                "experience-timeline mt-3",
                                roles.length === 1 &&
                                    "experience-timeline--single",
                            ]}
                        >
                            {roles.map(
                                ({ entry, Content, excerpt, isTruncated }) => (
                                    <li class="experience-role">
                                        <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                                            <p class="text-sm font-medium text-text">
                                                {entry.data.position}
                                            </p>
                                            <time class="shrink-0 text-xs text-text-muted tabular-nums">
                                                {entry.data.years}
                                            </time>
                                        </div>
                                        <p class="experience-excerpt mt-1.5 text-sm leading-relaxed text-text-muted">
                                            {excerpt}
                                        </p>
                                        {isTruncated && (
                                            <details class="entry-details mt-2">
                                                <summary class="text-sm text-accent">
                                                    Read more
                                                </summary>
                                                <div class="markdown mt-2 text-sm text-text-muted">
                                                    <Content />
                                                </div>
                                            </details>
                                        )}
                                        {entry.data.skills &&
                                            entry.data.skills.length > 0 && (
                                                <div class="mt-2 flex flex-wrap gap-1.5">
                                                    {entry.data.skills.map(
                                                        (s) => (
                                                            <TechPill
                                                                label={s.skill}
                                                                icon={
                                                                    s.skillLogo
                                                                }
                                                            />
                                                        ),
                                                    )}
                                                </div>
                                            )}
                                    </li>
                                ),
                            )}
                        </ul>
                    </div>
                </div>
            </li>
        ))
    }
</ul>
