---
import { getCollection, render } from "astro:content";
import Mascot from "@/components/react/Mascot.tsx";
import { creatureFor } from "@/lib/cast";
import TechPill from "./TechPill.astro";

type ExperienceItem = {
    entry: Awaited<ReturnType<typeof getCollection<"experiences">>>[number];
    Content: Awaited<ReturnType<typeof render>>["Content"];
    excerpt: string;
    isTruncated: boolean;
};

const EXCERPT_LENGTH = 210;

function getPlainText(markdown: string) {
    return markdown
        .replace(/```[\s\S]*?```/g, " ")
        .replace(/`([^`]+)`/g, "$1")
        .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
        .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
        .replace(/^#{1,6}\s+/gm, "")
        .replace(/^[-*+]\s+/gm, "")
        .replace(/[*_~>]/g, "")
        .replace(/\s+/g, " ")
        .trim();
}

function getExcerpt(markdown: string, maxLength = EXCERPT_LENGTH) {
    const text = getPlainText(markdown);

    if (text.length <= maxLength) {
        return { excerpt: text, isTruncated: false };
    }

    const truncated = text.slice(0, maxLength);
    const lastSpace = truncated.lastIndexOf(" ");
    return {
        excerpt: `${truncated.slice(0, lastSpace > 0 ? lastSpace : maxLength)}…`,
        isTruncated: true,
    };
}

const entries = (await getCollection("experiences")).sort((a, b) =>
    a.id.localeCompare(b.id),
);

const items: ExperienceItem[] = await Promise.all(
    entries.map(async (entry) => {
        const { Content } = await render(entry);
        const { excerpt, isTruncated } = getExcerpt(entry.body ?? "");
        return { entry, Content, excerpt, isTruncated };
    }),
);

const groupMap = new Map<string, ExperienceItem[]>();
for (const item of items) {
    const key = item.entry.data.location;
    const group = groupMap.get(key) ?? [];
    group.push(item);
    groupMap.set(key, group);
}

for (const group of groupMap.values()) {
    group.sort((a, b) => a.entry.id.localeCompare(b.entry.id));
}

const groups = [...groupMap.entries()]
    .map(([location, roles]) => ({
        location,
        roles,
        sortKey: roles[0]!.entry.id,
    }))
    .sort((a, b) => a.sortKey.localeCompare(b.sortKey));
---

<div class="orgs">
    {
        groups.map(({ location, roles }) => {
            const { shape, tone } = creatureFor(location);
            const current = roles.some(({ entry }) =>
                /present|now/i.test(entry.data.years),
            );
            return (
                <article class="org" data-tone={tone}>
                    <div class="org__face">
                        <Mascot
                            client:visible
                            seed={location}
                            shape={shape}
                            tone={tone}
                            label={`Poke the ${location} blobatar`}
                        />
                    </div>

                    <div class="min-w-0">
                        <h2 class="org__name">
                            {location}
                            {current && <span class="sticker">right now</span>}
                        </h2>

                        <div class="org__roles">
                            {roles.map(
                                ({ entry, Content, excerpt, isTruncated }) => (
                                    <div class="role">
                                        <div class="role__head">
                                            <span class="role__title">
                                                {entry.data.position}
                                            </span>
                                            <span class="role__years">
                                                {entry.data.years}
                                            </span>
                                        </div>

                                        <p class="role__summary">{excerpt}</p>

                                        {isTruncated && (
                                            <>
                                                <div
                                                    class="role__full markdown"
                                                    id={`role-${entry.id}`}
                                                    hidden
                                                >
                                                    <Content />
                                                </div>
                                                <button
                                                    type="button"
                                                    class="more-toggle"
                                                    aria-expanded="false"
                                                    aria-controls={`role-${entry.id}`}
                                                    data-more
                                                >
                                                    <span data-more-label>
                                                        Read the long version
                                                    </span>
                                                </button>
                                            </>
                                        )}

                                        {entry.data.skills &&
                                            entry.data.skills.length > 0 && (
                                                <div class="chips">
                                                    {entry.data.skills.map(
                                                        (s) => (
                                                            <TechPill
                                                                label={s.skill}
                                                                icon={
                                                                    s.skillLogo
                                                                }
                                                            />
                                                        ),
                                                    )}
                                                </div>
                                            )}
                                    </div>
                                ),
                            )}
                        </div>
                    </div>
                </article>
            );
        })
    }
</div>

<noscript>
    <style>
        .role__full[hidden] {
            display: block;
        }
        .role__summary,
        .more-toggle {
            display: none;
        }
    </style>
</noscript>

<script>
    // The button stays below the text: opening swaps the excerpt for the full
    // entry above it, closing puts the excerpt back.
    document.addEventListener("click", (event) => {
        const btn = (event.target as Element).closest<HTMLButtonElement>(
            "[data-more]",
        );
        if (!btn) return;
        const role = btn.closest<HTMLElement>(".role");
        const full = role?.querySelector<HTMLElement>(".role__full");
        const summary = role?.querySelector<HTMLElement>(".role__summary");
        const label = btn.querySelector<HTMLElement>("[data-more-label]");
        if (!role || !full || !summary || !label) return;

        const open = btn.getAttribute("aria-expanded") !== "true";
        full.hidden = !open;
        summary.hidden = open;
        btn.setAttribute("aria-expanded", String(open));
        label.textContent = open ? "Show less" : "Read the long version";

        // Closing from the bottom of a long entry would strand the reader
        // below the shorter section, so bring it back into view.
        if (!open)
            role.scrollIntoView({ block: "nearest", behavior: "smooth" });
    });
</script>
