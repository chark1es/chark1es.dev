---
interface Props {
    label: string;
    icon?: string;
    href?: string;
}

const { label, href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
    href={href}
    target={href ? "_blank" : undefined}
    rel={href ? "noopener noreferrer" : undefined}
    class="skill-token"
>
    {label}
</Tag>
