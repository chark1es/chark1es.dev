---
interface Props {
    label: string;
    icon?: string;
    href?: string;
}

const { label, icon, href } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
    href={href}
    target={href ? "_blank" : undefined}
    rel={href ? "noopener noreferrer" : undefined}
    class="inline-flex items-center gap-1 rounded-md bg-pill px-2 py-0.5 text-xs text-pill-text no-underline transition hover:opacity-80"
>
    {
        icon && (
            <iconify-icon icon={icon} height="14" width="14" aria-hidden="true" />
        )
    }
    {label}
</Tag>
