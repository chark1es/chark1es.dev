---
import { Image } from "astro:assets";
const schools = [
    {
        name: "University of California San Diego",
        detail: "B.S. Computer Science",
        years: "Aug 2022 – Jun 2026",
        logo: "/images/ucsd.png",
        url: "https://ucsd.edu",
    },
    {
        name: "Leuzinger High School",
        detail: "High School Diploma",
        years: "Aug 2018 – Jun 2022",
        logo: "/images/leuzinger.png",
        url: "https://leuzinger.org",
    },
];
---

<ul class="divide-y divide-border">
    {
        schools.map((school) => (
            <li class="flex gap-3 py-4 first:pt-0 last:pb-0">
                <Image
                    src={school.logo}
                    alt=""
                    width={32}
                    height={32}
                    class="mt-0.5 h-8 w-8 shrink-0 rounded-md bg-pill object-contain"
                />
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <p class="font-medium text-text">{school.name}</p>
                        <a
                            href={school.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex rounded-md bg-pill p-1.5 text-pill-text no-underline hover:opacity-80"
                            aria-label={`${school.name} website`}
                        >
                            <iconify-icon icon="mdi:web" height="14" width="14" />
                        </a>
                    </div>
                    <p class="text-sm text-text-muted">{school.detail}</p>
                    <p class="text-xs text-text-muted tabular-nums">
                        {school.years}
                    </p>
                </div>
            </li>
        ))
    }
</ul>
