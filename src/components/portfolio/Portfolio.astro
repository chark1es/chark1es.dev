---
import PageShell from "@/components/layout/PageShell.astro";
import Section from "@/components/layout/Section.astro";
import SiteAside from "@/components/layout/SiteAside.astro";
import MainCard from "./MainCard.astro";
import ExperienceList from "./ExperienceList.astro";
import ProjectList from "./ProjectList.astro";
import EducationCard from "./EducationCard.astro";
---

<PageShell variant="home">
    <div slot="rail" class="site-rail" aria-hidden="true">
        <span class="site-rail-label">chark1es.dev</span>
        <span class="site-rail-mark"></span>
    </div>

    <div class="home-sections pb-16">
        <Section title="About" id="about" index="01">
            <MainCard />
        </Section>
        <Section title="Experience" id="experience" index="02">
            <ExperienceList />
        </Section>
        <Section title="Projects" id="projects" index="03">
            <ProjectList />
        </Section>
        <Section title="Education" id="education" index="04">
            <EducationCard />
        </Section>
    </div>

    <SiteAside slot="aside" />
</PageShell>
