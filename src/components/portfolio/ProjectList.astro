---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import TechPill from "./TechPill.astro";

const entries = (await getCollection("projects")).sort((a, b) =>
    b.id.localeCompare(a.id),
);

const items = await Promise.all(
    entries.map(async (entry) => {
        const { Content } = await render(entry);
        return { entry, Content, hasDetails: Boolean(entry.body?.trim()) };
    }),
);
---

<ul class="divide-y divide-border">
    {
        items.map(({ entry, Content, hasDetails }) => (
            <li class="py-5 first:pt-0 last:pb-0">
                <div class="flex gap-3">
                    <Image
                        src={entry.data.logo}
                        alt=""
                        width={32}
                        height={32}
                        class="mt-0.5 h-8 w-8 shrink-0 rounded-md bg-pill object-contain"
                    />
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
                            <div>
                                <p class="font-medium text-text">
                                    {entry.data.projectName}
                                </p>
                                <p class="text-xs text-text-muted">
                                    {entry.data.projectRole} ·{" "}
                                    {entry.data.projectCompany} ·{" "}
                                    {entry.data.projectCategory}
                                </p>
                            </div>
                            <div class="flex shrink-0 items-center gap-2">
                                <time class="text-xs text-text-muted tabular-nums">
                                    {entry.data.years}
                                </time>
                                {entry.data.links?.map((link) => (
                                    <a
                                        href={link.link}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex rounded-md bg-pill p-1.5 text-pill-text no-underline hover:opacity-80"
                                        aria-label="Project link"
                                    >
                                        <iconify-icon
                                            icon={link.linkLogo}
                                            height="14"
                                            width="14"
                                        />
                                    </a>
                                ))}
                            </div>
                        </div>
                        {hasDetails && (
                            <details class="entry-details mt-2">
                                <summary class="text-sm text-accent">
                                    Read more
                                </summary>
                                <div class="markdown mt-2 text-sm text-text-muted">
                                    <Content />
                                </div>
                            </details>
                        )}
                        {entry.data.technologies &&
                            entry.data.technologies.length > 0 && (
                                <div class="mt-3 flex flex-wrap gap-1.5">
                                    {entry.data.technologies.map((t) => (
                                        <TechPill
                                            label={t.skill}
                                            icon={t.skillLogo}
                                        />
                                    ))}
                                </div>
                            )}
                    </div>
                </div>
            </li>
        ))
    }
</ul>
