---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import Layout from "./Layout.astro";
import { SITE } from "@config";
import Mascot from "@/components/react/Mascot.tsx";
import { creatureFor } from "@/lib/cast";

interface Props {
    post: CollectionEntry<"blogs">;
    Content: import("astro").MarkdownInstance<
        Record<string, unknown>
    >["Content"];
}

const { post, Content } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;

const ogUrl = new URL(
    heroImage ?? `${title.replace(/\s+/g, "-").toLowerCase()}.png`,
    Astro.url.origin,
).href;

const { remarkPluginFrontmatter } = await render(post);
const { shape, tone } = creatureFor(title);
---

<Layout
    title={`${title} · ${SITE.title}`}
    description={description}
    image={ogUrl}
>
    <div class="container-x page" data-tone={tone}>
        <article>
            <a href="/blogs" class="back-link">
                <svg
                    width="20"
                    height="10"
                    viewBox="0 0 20 10"
                    fill="none"
                    aria-hidden="true"
                >
                    <path d="M20 5H2" stroke="currentColor" stroke-width="1.3"
                    ></path>
                    <path
                        d="M6 1L2 5l4 4"
                        stroke="currentColor"
                        stroke-width="1.3"
                        fill="none"></path>
                </svg>
                All writing
            </a>

            <header class="page-head page-head--post mt-8">
                <div class="page-head__text">
                    <h1>{title}</h1>
                    {description && <p>{description}</p>}
                    <p class="!mt-5 !text-[0.95rem] !text-text-faint">
                        <FormattedDate date={pubDate} />
                        {
                            remarkPluginFrontmatter?.readingTime && (
                                <>
                                    {" · "}
                                    {remarkPluginFrontmatter.readingTime}
                                </>
                            )
                        }
                        {
                            tags.length > 0 && (
                                <>
                                    {" "}
                                    {" · "}
                                    {tags.join(" · ")}
                                </>
                            )
                        }
                    </p>
                </div>
                <div class="page-head__friend">
                    <Mascot
                        client:load
                        seed={title}
                        shape={shape}
                        tone={tone}
                        label="Poke this blobatar"
                    />
                </div>
            </header>

            <div class="article-body">
                <Content />
            </div>
        </article>
    </div>
</Layout>
