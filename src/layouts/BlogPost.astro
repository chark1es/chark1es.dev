---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import PageShell from "@/components/layout/PageShell.astro";
import Layout from "./Layout.astro";
import { SITE } from "@config";

interface Props {
    post: CollectionEntry<"blogs">;
    Content: import("astro").MarkdownInstance<Record<string, unknown>>["Content"];
}

const { post, Content } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;

const ogUrl = new URL(
    heroImage ?? `${title.replace(/\s+/g, "-").toLowerCase()}.png`,
    Astro.url.origin,
).href;

const { remarkPluginFrontmatter } = await render(post);
---

<Layout
    title={`${title} - ${SITE.title}`}
    description={description}
    image={ogUrl}
>
    <PageShell variant="content">
        <article class="py-10">
            <a
                href="/blogs"
                class="blog-back-button mb-8 inline-flex items-center gap-1.5 text-sm text-text-muted no-underline hover:text-text"
            >
                <span aria-hidden="true">←</span>
                All posts
            </a>

            <header class="border-b border-border pb-8">
                <h1
                    class="text-2xl font-semibold leading-tight tracking-tight text-text sm:text-[1.75rem]"
                >
                    {title}
                </h1>
                {
                    description && (
                        <p class="mt-3 text-base leading-relaxed text-text-muted">
                            {description}
                        </p>
                    )
                }
                <dl
                    class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-xs text-text-muted"
                >
                    <div class="flex gap-1.5">
                        <dt class="sr-only">Published</dt>
                        <dd>
                            <FormattedDate date={pubDate} />
                        </dd>
                    </div>
                    {
                        remarkPluginFrontmatter?.readingTime && (
                            <div class="flex gap-1.5">
                                <dt class="sr-only">Reading time</dt>
                                <dd>{remarkPluginFrontmatter.readingTime}</dd>
                            </div>
                        )
                    }
                    {
                        tags.length > 0 && (
                            <div class="flex gap-1.5">
                                <dt class="sr-only">Topics</dt>
                                <dd>{tags.join(" · ")}</dd>
                            </div>
                        )
                    }
                </dl>
            </header>

            <div class="article-body pt-10">
                <Content />
            </div>
        </article>
    </PageShell>

    <script>
        document.querySelectorAll(".blog-back-button").forEach((button) => {
            button.addEventListener("click", (e) => {
                if (window.history.length > 1) {
                    e.preventDefault();
                    window.history.back();
                }
            });
        });
    </script>
</Layout>
