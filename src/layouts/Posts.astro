---
import FormattedDate from "@/components/FormattedDate.astro";
import Layout from "@/layouts/Layout.astro";
import Mascot from "@/components/react/Mascot.tsx";
import { SITE } from "@config";
import { FRIENDS, creatureFor } from "@/lib/cast";
import type { CollectionEntry } from "astro:content";
import getReadingTime from "reading-time";

interface Props {
    posts: CollectionEntry<"blogs">[];
    title: string;
    description: string;
}

const { posts, description } = Astro.props;
const me = FRIENDS.writing;

const sorted = [...posts].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={`Writing · ${SITE.title}`} description={description}>
    <div class="container-x page" data-tone={me.tone}>
        <header class="page-head">
            <div class="page-head__text">
                <h1>Writing</h1>
                <p>
                    Notes to myself that turned out to be useful to other people
                    too.
                </p>
            </div>
            <div class="page-head__friend">
                <Mascot
                    client:load
                    seed={me.seed}
                    shape={me.shape}
                    tone={me.tone}
                    hover="thinking"
                    label="Poke the writing blobatar"
                />
            </div>
        </header>

        <div class="notes">
            {
                sorted.map((post) => {
                    const { shape, tone } = creatureFor(post.data.title);
                    return (
                        <a href={`/blogs/${post.id}`} class="note-row">
                            <div class="note-row__face">
                                <Mascot
                                    client:visible
                                    seed={post.data.title}
                                    shape={shape}
                                    tone={tone}
                                    hover="happy"
                                    label="Poke this blobatar"
                                />
                            </div>
                            <div>
                                <h2 class="note-row__title">
                                    {post.data.title}
                                </h2>
                                <p class="note-row__meta">
                                    <FormattedDate date={post.data.pubDate} />
                                    {post.body && (
                                        <>
                                            {" · "}
                                            {getReadingTime(post.body).text}
                                        </>
                                    )}
                                </p>
                                <p class="note-row__desc">
                                    {post.data.description}
                                </p>
                            </div>
                        </a>
                    );
                })
            }

            {
                sorted.length === 0 && (
                    <p class="py-14 text-text-muted">Nothing here yet.</p>
                )
            }
        </div>
    </div>
</Layout>
