---
import FormattedDate from "@/components/FormattedDate.astro";
import PageShell from "@/components/layout/PageShell.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@config";
import type { CollectionEntry } from "astro:content";
import getReadingTime from "reading-time";

interface Props {
    posts: CollectionEntry<"blogs">[];
    title: string;
    description: string;
}

const { posts, description } = Astro.props;

const sorted = [...posts].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
    title={`Blog - ${SITE.title}`}
    description={description}
>
    <PageShell variant="content">
        <div class="py-10">
            <header class="mb-2 border-b border-border pb-8">
                <p class="text-xs font-semibold uppercase tracking-widest text-text-muted">
                    Writing
                </p>
                <h1 class="mt-2 text-2xl font-semibold tracking-tight text-text">
                    Blog
                </h1>
                <p class="mt-2 max-w-2xl text-sm text-text-muted">
                    {description}
                </p>
            </header>

            <div role="list">
                {
                    sorted.map((post) => (
                        <a
                            href={`/blogs/${post.id}`}
                            class="blog-row"
                            role="listitem"
                        >
                            <div>
                                <h2 class="blog-row-title">{post.data.title}</h2>
                                <p class="blog-row-desc mt-1">
                                    {post.data.description}
                                </p>
                            </div>
                            <p class="blog-row-meta text-xs text-text-muted tabular-nums">
                                <FormattedDate date={post.data.pubDate} />
                                {post.body && (
                                    <>
                                        <br />
                                        {getReadingTime(post.body).text}
                                    </>
                                )}
                            </p>
                        </a>
                    ))
                }
            </div>

            {
                sorted.length === 0 && (
                    <p class="py-12 text-sm text-text-muted">No posts yet.</p>
                )
            }
        </div>
    </PageShell>
</Layout>
