---
import "@/styles/globals.css";
import SEO from "@/components/seo/SEO.astro";
import Navigation from "@/components/layout/Navigation.astro";
import Footer from "@/components/layout/Footer.astro";

const {
    class: className,
    title,
    description,
    keywords,
    url,
    image,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <SEO
            title={title}
            description={description}
            keywords={keywords}
            url={url}
            image={image}
        />
        <link rel="stylesheet" href="/fonts/fonts.css" />
        <script is:inline>
            // Set the theme before first paint. Dark is the default; ?theme=light previews.
            (function () {
                var apply = function (doc) {
                    var t = null;
                    try {
                        var q = new URLSearchParams(location.search).get(
                            "theme",
                        );
                        if (q === "light" || q === "dark")
                            localStorage.setItem("theme", q);
                        t = localStorage.getItem("theme");
                    } catch (e) {}
                    doc.documentElement.dataset.theme =
                        t === "light" ? "light" : "dark";
                };
                apply(document);
            })();
        </script>
    </head>
    <body>
        <a href="#main" class="skip-link">Skip to content</a>

        <div class:list={["min-h-svh flex flex-col", className]}>
            <Navigation />
            <div id="main" class="flex-1">
                <slot />
            </div>
            <Footer />
        </div>

        <button
            id="scrollToTopBtn"
            type="button"
            aria-label="Scroll to top"
            class="to-top"
        >
            <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M8 13V3M3.5 7.5L8 3l4.5 4.5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </button>

        <script>
            const handleScroll = () => {
                const btn = document.getElementById("scrollToTopBtn");
                if (!btn) return;
                const show = window.scrollY > 240;
                btn.classList.toggle("is-visible", show);
            };

            const scrollToTop = () =>
                window.scrollTo({ top: 0, behavior: "smooth" });

            const bindScrollTop = () => {
                const btn = document.getElementById("scrollToTopBtn");
                if (!btn || btn.dataset.bound === "true") return;
                btn.dataset.bound = "true";
                btn.addEventListener("click", scrollToTop);
            };
            const syncToggle = () => {
                const light =
                    document.documentElement.dataset.theme === "light";
                document
                    .querySelectorAll<HTMLElement>("[data-theme-toggle]")
                    .forEach((btn) =>
                        btn.setAttribute("aria-pressed", String(light)),
                    );
            };

            document.addEventListener("click", (event) => {
                const btn = (event.target as Element).closest(
                    "[data-theme-toggle]",
                );
                if (!btn) return;
                const next =
                    document.documentElement.dataset.theme === "light"
                        ? "dark"
                        : "light";
                document.documentElement.dataset.theme = next;
                try {
                    localStorage.setItem("theme", next);
                } catch (e) {}
                syncToggle();
            });

            window.addEventListener("scroll", handleScroll, { passive: true });
            document.addEventListener("DOMContentLoaded", () => {
                handleScroll();
                bindScrollTop();
                syncToggle();
            });
        </script>
    </body>
</html>
